{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tracepaper-public",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "CANVAS", "class_name": "Canvas" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Canvas", "Registry"] }
  ],
  "observability": { "enabled": true }
}
