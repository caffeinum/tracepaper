{
  "name": "paper-mcp",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "paper-mcp": "src/index.ts"
  },
  "files": [
    "src",
    "web",
    "SPEC.md"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "serve": "bun run src/index.ts serve",
    "build:web": "bun build web/canvas.ts --outfile web/dist/canvas.js --target browser --minify",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
