{
  "$schema": "https://api.thecompany.company/schemas/v1/environment.json",
  "scripts": {
    "install": {
      "command": "bun install --frozen-lockfile",
      "timeout": 300
    },
    "prepare": {
      "command": "bun install --frozen-lockfile && bun run build:web",
      "timeout": 120
    },
    "start": {
      "command": "bun run serve"
    }
  },
  "env": {
    "TRACEPAPER_HOST": "0.0.0.0",
    "TRACEPAPER_PORT": "4321"
  }
}
